---
import { nav } from '../data/nav';
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
const current = Astro.url.pathname;
---
<nav class="nav" aria-label="Main">
  {[nav.slice(0, 3), nav.slice(3)].map((row) => (
  <ul>
    {row.map((item) => {
      const href = base + item.path;
      return (
        <li>
          <a class="eyebrow" href={href} aria-current={current === href ? 'page' : undefined}><span>{item.label}</span></a>
        </li>
      );
    })}
  </ul>
  ))}
</nav>

<style>
  /* Sticky glass bar: content scrolls beneath it, blurred.
     Links use the eyebrow style. Each link is a 48px-tall touch target (padding, not just text);
     two rows of 48px + 8px top/bottom = --nav-h (112px). */
  .nav {
    position: sticky; top: 0; z-index: 20;
    box-sizing: border-box; min-height: var(--nav-h); padding: var(--space-1) var(--space-2);
    background: color-mix(in srgb, var(--color-bg) 60%, transparent);
    -webkit-backdrop-filter: blur(16px) saturate(1.4); backdrop-filter: blur(16px) saturate(1.4);
    box-shadow: 0 1px 0 color-mix(in srgb, var(--color-bg) 50%, transparent);   /* edge line without adding height */
  }
  ul { list-style: none; margin: 0; padding: 0; display: flex; justify-content: space-evenly; }
  a {
    display: flex; align-items: center; justify-content: center;
    min-height: 48px; min-width: 48px; padding-inline: 4px;
    color: var(--color-text); text-decoration: none;
  }
  a span { padding-bottom: 4px; border-bottom: 1px solid transparent; }
  a[aria-current='page'] span { border-bottom-color: var(--color-accent); }
  a:hover span { border-bottom-color: var(--color-rule); }
  a:focus-visible { outline: 2px solid var(--color-accent); outline-offset: -4px; }

  /* Narrow phones: tighten tracking so four labels still fit one row */
  @media (max-width: 359px) { a { letter-spacing: 2px; } }
  @media (max-width: 329px) { a { letter-spacing: 1px; } }
</style>
