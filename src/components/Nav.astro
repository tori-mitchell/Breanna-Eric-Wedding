---
import { nav } from '../data/nav';
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
const current = Astro.url.pathname;
---
<nav class="nav" aria-label="Main">
  {[nav.slice(0, 3), nav.slice(3)].map((row) => (
  <ul>
    {row.map((item) => {
      const href = base + item.path;
      return (
        <li>
          <a href={href} aria-current={current === href ? 'page' : undefined}>{item.label}</a>
        </li>
      );
    })}
  </ul>
  ))}
</nav>

<style>
  /* Sticky glass bar: content scrolls beneath it, blurred */
  .nav {
    position: sticky; top: 0; z-index: 20;
    box-sizing: border-box; min-height: var(--nav-h); padding: var(--space-4) var(--gutter) var(--space-2);
    background: color-mix(in srgb, var(--color-bg) 60%, transparent);
    -webkit-backdrop-filter: blur(16px) saturate(1.4); backdrop-filter: blur(16px) saturate(1.4);
    border-bottom: 1px solid color-mix(in srgb, var(--color-bg) 50%, transparent);
  }
  ul {
    list-style: none; margin: 0; padding: 0;
    display: flex; justify-content: center; gap: var(--space-3);
  }
  ul + ul { margin-top: var(--space-2); }
  a {
    font-weight: 600; letter-spacing: 0.06em;
    text-decoration: none; padding-bottom: 0.25rem;
    border-bottom: 1px solid transparent;
  }
  a[aria-current='page'] { border-bottom-color: currentColor; }
  a:hover { border-bottom-color: var(--color-rule); }
  a:focus-visible { outline: 2px solid var(--color-label); outline-offset: 4px; }
</style>
