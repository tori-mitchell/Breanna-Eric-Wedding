---
import { nav } from '../data/nav';
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
const current = Astro.url.pathname;
---
<nav class="nav" aria-label="Main">
  <ul>
    {nav.map((item) => {
      const href = base + item.path;
      return (
        <li>
          <a href={href} aria-current={current === href ? 'page' : undefined}>{item.label}</a>
        </li>
      );
    })}
  </ul>
</nav>

<style>
  .nav { padding: var(--space-4) var(--gutter) var(--space-2); }
  ul {
    list-style: none; margin: 0 auto; padding: 0;
    display: flex; flex-wrap: wrap; justify-content: center;
    gap: var(--space-2) var(--space-3); max-width: 16.5rem;
  }
  a {
    font-size: var(--text-nav); font-weight: 600; letter-spacing: 0.06em;
    text-decoration: none; padding-bottom: 0.2rem;
    border-bottom: 1px solid transparent;
  }
  a[aria-current='page'] { border-bottom-color: currentColor; }
  a:hover { border-bottom-color: var(--color-rule); }
  a:focus-visible { outline: 2px solid var(--color-label); outline-offset: 4px; }
</style>
