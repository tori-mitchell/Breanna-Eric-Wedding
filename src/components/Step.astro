---
interface Props { n: string; title: string; }
const { n, title } = Astro.props;
---
<li class="step reveal">
  <span class="n">{n}</span>
  <h3>{title}</h3>
  <div><slot /></div>
</li>

<style>
  .step { list-style: none; text-align: center; padding: var(--space-3) var(--space-3); border-top: 1px solid var(--color-rule); }
  .step:first-child { border-top: 0; }
  .n { letter-spacing: var(--tracking-caps); }
  h3 { font-size: var(--text-script-md); margin: 0.25rem 0 var(--space-2); }
  div > :global(* + *) { margin-top: var(--space-2); }
</style>
