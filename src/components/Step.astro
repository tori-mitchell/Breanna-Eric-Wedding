---
interface Props { n: string; title: string; }
const { n, title } = Astro.props;
---
<li class="step reveal">
  <span class="n eyebrow">{n}</span>
  <h3 class="script">{title}</h3>
  <div><slot /></div>
</li>

<style>
  .step { list-style: none; text-align: center; padding: var(--space-3) var(--space-3); border-top: 1px solid var(--color-rule); }
  .step:first-child { border-top: 0; }
  .n { display: block; }
  h3 { margin: calc(var(--eyebrow-gap) - var(--ink-gap0) + 2.5px) 0 var(--space-2); } /* grid-exempt: optical, 40px script ink offset */
  div { text-align: left; }   /* body copy reads left-aligned; the eyebrow number and the script title stay centered */
  div > :global(* + *) { margin-top: var(--space-3); }
</style>
