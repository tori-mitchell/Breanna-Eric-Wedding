---
// One itinerary row: day + date (or a `time` for the daily schedules) on one line in the left column, title + description on the right.
// Below 360px wide there is no room for two columns, so the date stacks above the title.
interface Props { dow?: string; date?: string; time?: string; title: string; href?: string; }
const { dow, date, time, title, href } = Astro.props;
---
<div class="row">
  <p class="when eyebrow">{time ?? `${dow} ${date}`}</p>
  {href ? (
    <a class="what link" href={href}>
      <h2 class="subhead-sm"><span class="t">{title}</span><span class="arrow" aria-hidden="true">&#8594;&#xFE0E;</span></h2>
      <p class="small"><slot /></p>
    </a>
  ) : (
    <div class="what">
      <h2 class="subhead-sm">{title}</h2>
      <p class="small"><slot /></p>
    </div>
  )}
</div>

<style>
  .row.row { margin-top: 0; display: grid; grid-template-columns: 112px 1fr; gap: 24px; padding: 24px 0; border-top: 1px solid var(--color-rule); }
  .row:first-child { border-top: 0; padding-top: 0; }
  .row:last-of-type { padding-bottom: 0; }
  /* Day and date: one line, secondary color. padding-top lines its text up with the title's first line. */
  .when { margin: 0; padding-top: 4px; white-space: nowrap; color: var(--color-body); }
  .what > h2 { margin: 0; }
  .what > p { margin: 4px 0 0; }
  /* Tappable summary: the whole title + description block jumps to that day's detailed schedule */
  .link { display: block; color: inherit; text-decoration: none; }
  .arrow { margin-left: 4px; position: relative; top: 0; color: var(--color-body); font-family: var(--font-body); font-weight: 400; font-variant-emoji: text; transition: transform 150ms var(--ease); } /* grid-exempt: optical arrow alignment */
  .link:hover .arrow, .link:active .arrow { transform: translateX(4px); }
  /* Hover (mouse devices) or keyboard focus: the title gets underlined; the arrow stays clear of the underline */
  .t { text-decoration: underline transparent; text-decoration-thickness: 1px; text-underline-offset: 4px; transition: text-decoration-color 150ms var(--ease); }
  @media (hover: hover) { .link:hover .t { text-decoration-color: currentColor; } }
  .link:focus-visible .t { text-decoration-color: currentColor; }
  .link:focus-visible { outline: 2px solid var(--color-accent); outline-offset: 4px; }

  @media (max-width: 359px) {
    .row { grid-template-columns: 1fr; gap: 8px; }
    .when { padding-top: 0; }
  }
</style>
