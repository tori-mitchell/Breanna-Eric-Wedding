---
// One itinerary row: day/date in the left column, title + description on the right.
interface Props { dow: string; date: string; title: string; }
const { dow, date, title } = Astro.props;
---
<div class="row">
  <p class="when eyebrow"><span>{dow}</span><span>{date}</span></p>
  <div class="what">
    <h2 class="subhead-sm">{title}</h2>
    <p><slot /></p>
  </div>
</div>

<style>
  .row { display: grid; grid-template-columns: 88px 1fr; gap: 24px; padding: 24px 0; border-top: 1px solid var(--color-rule); }
  .row:first-child { border-top: 0; padding-top: 0; }
  .when { margin: 0; padding-top: 4px; display: grid; gap: 4px; align-content: start; }
  .what > h2 { margin: 0; }
  .what > p { margin: 4px 0 0; }
</style>
