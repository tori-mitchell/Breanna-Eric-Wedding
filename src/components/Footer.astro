---
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
---
<footer class="footer">
  <img src={`${base}images/placeholders/art-hills.jpg`} alt="" data-temp />
  <p>B &amp; E · 09.2027</p>
</footer>

<style>
  .footer { margin-top: var(--space-5); text-align: center; }
  img { width: 100%; }
  p { padding: var(--space-3) var(--gutter) var(--space-4); font-size: var(--text-label); letter-spacing: var(--tracking-caps); color: var(--color-label); }
</style>
