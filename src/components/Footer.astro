---
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
---
<footer class="footer">
  <img src={`${base}images/placeholders/art-hills.jpg`} alt="" data-temp />
  <p>B &amp; E · 09.2027</p>
</footer>

<style>
  .footer { margin-top: var(--space-5); text-align: center; }
  img { width: 100%; }
  p { padding: var(--space-2) var(--gutter) calc(var(--space-2) + env(safe-area-inset-bottom, 0px)); letter-spacing: var(--tracking-caps); text-transform: uppercase; color: var(--color-label); }
</style>
