---
// One banner image spans the title: leafy watercolor corners at each end, the script title centered over the blank middle.
interface Props { title: string; }
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
---
<header class="title">
  <img class="banner" src={`${base}images/art/header.jpg`} alt="" width="1360" height="354" />
  <h1>{Astro.props.title}</h1>
</header>

<style>
  .title { display: grid; place-items: center; padding: var(--space-2) 0 0; max-width: 960px; margin-inline: auto; }   /* the banner stops growing on wide screens */
  .title > * { grid-area: 1 / 1; }
  /* Paper in the image is pure white, so multiply leaves the page texture alone; edges fade out on all four sides. */
  .banner { width: 100%; height: auto; display: block; mix-blend-mode: multiply;
    -webkit-mask-image: linear-gradient(to right, transparent, #000 6%, #000 94%, transparent), linear-gradient(to bottom, transparent, #000 22%, #000 78%, transparent);
    -webkit-mask-composite: source-in; mask-image: linear-gradient(to right, transparent, #000 6%, #000 94%, transparent), linear-gradient(to bottom, transparent, #000 22%, #000 78%, transparent); mask-composite: intersect; }
  /* Phones: the title is nearly as wide as the banner, so fade the middle of the art (leaves above the ascenders, hills below the descenders)
     and lighten the whole banner slightly; the arch and olive branches at each end stay full strength. */
  @media (max-width: 599px) {
    .banner { opacity: 0.88;
      -webkit-mask-image: linear-gradient(to right, transparent, #000 6%, #000 14%, rgba(0, 0, 0, 0.2) 28%, rgba(0, 0, 0, 0.2) 72%, #000 86%, #000 94%, transparent), linear-gradient(to bottom, transparent, #000 22%, #000 78%, transparent);
      mask-image: linear-gradient(to right, transparent, #000 6%, #000 14%, rgba(0, 0, 0, 0.2) 28%, rgba(0, 0, 0, 0.2) 72%, #000 86%, #000 94%, transparent), linear-gradient(to bottom, transparent, #000 22%, #000 78%, transparent); }
  }
  h1 { text-align: center; white-space: nowrap; position: relative; z-index: 1; }
</style>
