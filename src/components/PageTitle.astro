---
// Banner art flanks the title. Temporary screenshot crops for now (docs/CONTENT-TODO.md §3).
interface Props { title: string; }
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
---
<header class="title">
  <img class="side wc wc-landscape" src={`${base}images/art/banner-l.jpg`} alt="" />
  <h1>{Astro.props.title}</h1>
  <img class="side wc wc-landscape" src={`${base}images/art/banner-r.jpg`} alt="" />
</header>

<style>
  .title {
    display: grid; grid-template-columns: 1fr auto 1fr; align-items: center;
    gap: var(--space-1); padding: var(--space-2) 0 0;   /* no bottom padding: the section margin below drives the gap */
  }
  h1 { text-align: center; white-space: nowrap; }
  .side { width: 100%; height: 5rem; object-fit: cover; mix-blend-mode: multiply; }
  .side:first-child { object-position: right; }
</style>
