---
// Banner art flanks the title. Temporary screenshot crops for now (docs/CONTENT-TODO.md §3).
interface Props { title: string; }
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
---
<header class="title">
  <img class="side" src={`${base}images/placeholders/art-banner-l.jpg`} alt="" data-temp />
  <h1>{Astro.props.title}</h1>
  <img class="side" src={`${base}images/placeholders/art-banner-r.jpg`} alt="" data-temp />
</header>

<style>
  .title {
    display: grid; grid-template-columns: 1fr auto 1fr; align-items: center;
    gap: var(--space-1); padding: var(--space-2) 0 var(--space-3);
  }
  h1 { font-size: var(--text-script-lg); text-align: center; white-space: nowrap; }
  .side { width: 100%; height: 5rem; object-fit: cover; }
  .side:first-child { object-position: right; }
</style>
