---
// Image slot. Renders a labeled placeholder until `src` (path under /public) is provided.
// Every image except full-bleed ones gets an irregular, watercolor-style fade at its edges (a mask,
// chosen by aspect ratio). The magenta placeholder outline sits on the figure so the mask doesn't hide it.
interface Props { src?: string; alt?: string; ratio?: string; label?: string; bleed?: boolean; narrow?: boolean; art?: boolean; soft?: boolean; blend?: boolean; mid?: boolean; wash?: 'left' | 'right'; accent?: 'sage' | 'peach'; }
const { src, alt = '', ratio = '4 / 3', label = 'Photo', bleed = false, narrow = false, art = false, soft = false, blend = false, mid = false, wash, accent } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
const [rw, rh] = ratio.split('/').map((n) => parseFloat(n));
const r = rw / (rh || 1);
const shape = r > 1.15 ? 'landscape' : r < 0.87 ? 'portrait' : 'square';
---
<figure class:list={['fig', shape, { bleed, narrow, art, soft, blend, mid, washed: !!wash }]} data-wash={wash} data-accent={accent} style={`--ratio:${ratio};--washimg:url(${base}images/wash-smudge.webp)`} data-temp={src && src.includes('placeholders/') ? '' : undefined}>
  {src ? <img src={`${base}${src.replace(/^\//, '')}`} alt={alt} loading="lazy" /> : <div class="ph" role="img" aria-label={alt || label}><span>{label}</span></div>}
</figure>

<style>
  .fig { margin: 0; width: 100%; }
  .fig.narrow { width: 80%; margin-inline: auto; }
  .fig.bleed { width: 100vw; margin-inline: calc(50% - 50vw); }
  img, .ph { display: block; width: 100%; aspect-ratio: var(--ratio); object-fit: cover; }
  .ph {
    display: grid; place-items: center; text-align: center; padding: var(--space-2);
    background: var(--temp-box);
    color: var(--color-text); font-size: 1rem;
  }

  /* Watercolor edge: the picture fades into the paper along an irregular, bleeding edge. */
  .fig:not(.bleed) img, .fig:not(.bleed) .ph { -webkit-mask-size: 100% 100%; mask-size: 100% 100%; -webkit-mask-repeat: no-repeat; mask-repeat: no-repeat; }
  .landscape:not(.bleed) img, .landscape:not(.bleed) .ph { -webkit-mask-image: url('../assets/photo-mask-landscape.webp'); mask-image: url('../assets/photo-mask-landscape.webp'); }
  .portrait:not(.bleed) img, .portrait:not(.bleed) .ph { -webkit-mask-image: url('../assets/photo-mask-portrait.webp'); mask-image: url('../assets/photo-mask-portrait.webp'); }
  .square:not(.bleed) img, .square:not(.bleed) .ph { -webkit-mask-image: url('../assets/photo-mask-square.webp'); mask-image: url('../assets/photo-mask-square.webp'); }
  /* Soft: a light feather instead of the wide watercolor fade (photos of people: keeps faces intact) */
  .soft.landscape:not(.bleed) img { -webkit-mask-image: url('../assets/photo-mask-landscape-soft.webp'); mask-image: url('../assets/photo-mask-landscape-soft.webp'); }
  .soft.portrait:not(.bleed) img { -webkit-mask-image: url('../assets/photo-mask-portrait-soft.webp'); mask-image: url('../assets/photo-mask-portrait-soft.webp'); }
  .soft.square:not(.bleed) img { -webkit-mask-image: url('../assets/photo-mask-square-soft.webp'); mask-image: url('../assets/photo-mask-square-soft.webp'); }
  /* Blend: the longest, softest feather (Our Story collages) so overlapping photos melt into each other and the paper */
  .blend.landscape:not(.bleed) img { -webkit-mask-image: url('../assets/photo-mask-landscape-blend.webp'); mask-image: url('../assets/photo-mask-landscape-blend.webp'); }
  .blend.portrait:not(.bleed) img { -webkit-mask-image: url('../assets/photo-mask-portrait-blend.webp'); mask-image: url('../assets/photo-mask-portrait-blend.webp'); }
  .blend.square:not(.bleed) img { -webkit-mask-image: url('../assets/photo-mask-square-blend.webp'); mask-image: url('../assets/photo-mask-square-blend.webp'); }
  /* Mid: between soft and blend (a subject close to a corner) */
  .mid.landscape:not(.bleed) img { -webkit-mask-image: url('../assets/photo-mask-landscape-mid.webp'); mask-image: url('../assets/photo-mask-landscape-mid.webp'); }
  .mid.portrait:not(.bleed) img { -webkit-mask-image: url('../assets/photo-mask-portrait-mid.webp'); mask-image: url('../assets/photo-mask-portrait-mid.webp'); }
  .mid.square:not(.bleed) img { -webkit-mask-image: url('../assets/photo-mask-square-mid.webp'); mask-image: url('../assets/photo-mask-square-mid.webp'); }
  /* Washes: a blue watercolor smudge peeking out on one side, plus an optional sage / peach accent on the other */
  .washed { position: relative; isolation: isolate; }
  .washed::before, .washed::after { content: ''; position: absolute; z-index: -1; aspect-ratio: 1; width: 56%; max-width: 240px; pointer-events: none; }
  .washed::before { background: var(--color-accent); -webkit-mask: var(--washimg) center / 100% 100% no-repeat; mask: var(--washimg) center / 100% 100% no-repeat; opacity: 0.45; top: 6%; }
  .washed[data-wash='left']::before { left: -8%; }
  .washed[data-wash='right']::before { right: -8%; transform: scaleX(-1); }
  .washed::after { bottom: 2%; opacity: 0.6; -webkit-mask: var(--washimg) center / 100% 100% no-repeat; mask: var(--washimg) center / 100% 100% no-repeat; background: transparent; }
  .washed[data-accent='sage']::after { background: var(--color-sage); }
  .washed[data-accent='peach']::after { background: var(--color-peach); opacity: 0.7; }
  .washed[data-wash='left']::after { right: -8%; transform: scaleX(-1) rotate(14deg); }
  .washed[data-wash='right']::after { left: -8%; transform: rotate(-14deg); }
</style>
