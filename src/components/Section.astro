---
interface Props { align?: 'left' | 'center'; tight?: boolean; id?: string; wide?: boolean; mid?: boolean; split?: boolean; flip?: boolean; rows?: number; }
const { align = 'left', tight = false, id, wide = false, mid = false, split = false, flip = false, rows = 3 } = Astro.props;
---
<section id={id} class:list={['section', 'reveal', { tight, wide, mid, split, flip }]} style={split ? `--rows:${rows}` : undefined} data-align={align}><slot /></section>

<style>
  /* One rhythm: --flow (16px) between text blocks, --block (48px) around sections and media,
     identical above and below so nothing looks bottom-heavy. */
  .section[id] { scroll-margin-top: calc(var(--nav-h) + 32px); }   /* anchored sections clear the sticky nav */
  .section { position: relative; padding-inline: var(--gutter); margin-block: var(--block); box-sizing: content-box; max-width: var(--column); margin-inline: auto; }
  /* Under a page title the standard 48px section margin is the only gap (the title has no bottom padding). */
  .section.tight { margin-block: calc(var(--flow) * 2); }   /* 32px: denser lists, still symmetric */
  .section > :global(* + *) { margin-top: var(--flow); }
  .section > :global(h2) { margin-top: var(--space-4); }
  /* eyebrow hugs its heading: visible gap = --eyebrow-gap (see global.css) */
  .section > :global(.eyebrow + h1), .section > :global(.eyebrow + h2), .section > :global(.eyebrow + h3) { margin-top: calc(var(--eyebrow-gap) - var(--ink-gap0)); }
  .section > :global(.info + .info) { margin-top: calc(var(--flow) * 2); }   /* 32px between info blocks */
  .section :global(.fig), .section :global(.frame) { margin-block: var(--block); }
  .section :global(.fig + .fig), .section :global(.fig + .frame), .section :global(.frame + .fig) { margin-top: 0; }
  .section > :global(:first-child) { margin-top: 0; }
  .section > :global(:last-child) { margin-bottom: 0; }
  /* wide: a two-column section on desktop (the column widens to 1040px at >= 1024px; phones unaffected) */
  @media (min-width: 1024px) {
    /* Desktop: the first section under a page title sits closer to it (48px, instead of the 72px section gap) */
    :global(.title) + .section { margin-top: 3rem; }
    .section.wide { max-width: var(--column-wide); }
    .section.mid { max-width: var(--column-mid); }   /* single column, 480px */
  }
  /* split: desktop (>= 1024px) puts the section's last element (its image) beside the text instead of below it.
     Text is one column and vertically centered against the image; `flip` puts the image on the left. `rows` = number of text blocks.
     Phones are untouched: the section stays a single stacked column. */
  @media (min-width: 1024px) {
    .section.split { display: grid; grid-template-columns: 1fr 1fr; column-gap: var(--col-gap); grid-template-rows: 1fr repeat(var(--rows), auto) 1fr; }
    .section.split::before { content: ''; grid-column: 1; grid-row: 1; }
    .section.split > :not(:global(.fig)) { grid-column: 1; }
    .section.split > :global(.fig) { grid-column: 2; grid-row: 1 / -1; align-self: center; margin-block: 0; width: 100%; }
    .section.split.flip > :not(:global(.fig)) { grid-column: 2; }
    .section.split.flip::before { grid-column: 2; }
    .section.split.flip > :global(.fig) { grid-column: 1; }
  }
</style>
