---
// Pill button: solid accent fill with a light-blue ring.
interface Props { href: string; }
---
<a class="btn" href={Astro.props.href}><slot /> <span aria-hidden="true">→</span></a>

<style>
  .btn {
    box-sizing: border-box; display: inline-flex; align-items: center; justify-content: center; gap: 8px;
    height: 64px; padding: 0 32px; border: 4px solid var(--color-label); border-radius: 32px;
    background: var(--color-accent); color: #fff; text-decoration: none;
    font-family: var(--font-sans); font-weight: 500; font-size: 1rem; letter-spacing: 0.02em;
  }
  .btn:hover { filter: brightness(1.08); }
  .btn:focus-visible { outline: 2px solid var(--color-accent); outline-offset: 4px; }
</style>
