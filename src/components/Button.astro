---
// Solid button. Label uses the eyebrow style (sans caps) in the page color; square corners per --radius.
interface Props { href: string; }
---
<a class="btn eyebrow" href={Astro.props.href}><slot /></a>

<style>
  .btn {
    box-sizing: border-box; display: inline-flex; align-items: center; justify-content: center;
    height: 48px; padding: 0 32px; border-radius: var(--radius);
    background: var(--color-accent); color: var(--color-bg); text-decoration: none;
  }
  .btn:hover { background: color-mix(in srgb, var(--color-accent) 85%, var(--color-bg)); }
  .btn:focus-visible { outline: 2px solid var(--color-accent); outline-offset: 4px; }
</style>
