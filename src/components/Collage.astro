---
// A loose collage of overlapping, slightly tilted photos over soft watercolor washes.
// layout="zigzag" (default): photos alternate left/right, each tucked over the one above (best for 2).
// layout="cluster": first photo on top, the rest in overlapping pairs below, so the group reads as one round-ish
//   blob with no hole in the middle (use for 3+ photos).
// rich: two extra washes (a blue one tucked behind the middle, a gentle sage-green one low and off to the side).
// `overlap` = how far each row tucks over the one above (px). Pass `items`; per-item w (% of width), tilt (deg), side (zigzag).
import Figure from './Figure.astro';
interface Item { src: string; ratio: string; label: string; w?: number; side?: 'left' | 'right'; tilt?: number; z?: number; pos?: string; fade?: 'soft' | 'mid' | 'blend'; }
interface Props { items: Item[]; wash?: 'left' | 'right'; overlap?: number; layout?: 'zigzag' | 'cluster'; rich?: boolean; accent?: 'sage' | 'peach'; center?: boolean; }
const { items, wash = 'right', overlap = 48, layout = 'zigzag', rich = false, accent, center = false } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
const idx = items.map((_, i) => i);
const rows: number[][] = layout === 'cluster'
  ? [[0], ...Array.from({ length: Math.ceil((items.length - 1) / 2) }, (_, r) => idx.slice(1 + r * 2, 3 + r * 2))]
  : idx.map((i) => [i]);
---
<div class:list={['collage', wash, layout, { rich }]} data-accent={accent} style={`--wash:url(${base}images/wash-smudge.webp);--ov:${overlap}px`}>
  {center && <i class="w w5" aria-hidden="true" />}
  {accent && !rich && <i class="w w4" aria-hidden="true" />}
  {rich && <><i class="w w3" aria-hidden="true" /><i class="w w4" aria-hidden="true" /></>}
  {rows.map((row, r) => (
    <div class:list={['row', layout === 'zigzag' ? (items[row[0]].side ?? (r % 2 ? 'right' : 'left')) : 'mid']} style={`--z:${items[row[0]].z ?? r + 1}`}>
      {row.map((i) => (
        <div class="piece" style={`--w:${items[i].w ?? 64}%;--tilt:${items[i].tilt ?? 0}deg;--pos:${items[i].pos ?? 'center'}`}>
          <Figure soft={items[i].fade === 'soft'} mid={items[i].fade === 'mid'} blend={!items[i].fade || items[i].fade === 'blend'} src={items[i].src} ratio={items[i].ratio} label={items[i].label} />
        </div>
      ))}
    </div>
  ))}
</div>

<style>
  /* .collage.collage outranks Section's `* + *` spacing */
  .collage.collage { position: relative; display: flex; flex-direction: column; margin-block: var(--block); isolation: isolate; }
  .collage::before, .collage::after { content: ''; position: absolute; z-index: -1; width: 240px; aspect-ratio: 1; background: var(--wash) center / 100% 100% no-repeat; mix-blend-mode: multiply; opacity: 0.5; pointer-events: none; } /* grid-exempt: wash size */
  .collage.right::before { right: -48px; top: 8%; }
  .collage.right::after { left: -56px; bottom: 4%; transform: scaleX(-1); }
  .collage.left::before { left: -56px; top: 8%; transform: scaleX(-1); }
  .collage.left::after { right: -48px; bottom: 4%; }
  /* Extra accents (rich): behind everything, peeking out between and around the photos */
  .w { position: absolute; z-index: -1; aspect-ratio: 1; background: var(--wash) center / 100% 100% no-repeat; mix-blend-mode: multiply; pointer-events: none; }
  .w3 { width: 208px; left: -40px; top: 42%; opacity: 0.5; transform: rotate(24deg); }
  .w4 { width: 224px; right: -48px; bottom: -16%; opacity: 0.7; transform: scaleX(-1) rotate(-18deg); background: var(--color-sage); -webkit-mask: var(--wash) center / 100% 100% no-repeat; mask: var(--wash) center / 100% 100% no-repeat; }   /* gentle sage green (--color-sage) */
  /* keep the green off the blue washes (overlap turns it muddy): on left-wash collages it moves to the upper right, and on right-wash ones to the lower right */
  .collage.left:not([data-accent]) .w4 { bottom: auto; top: -12%; }
  /* center: a blue wash tucked behind the middle, to fill the gap where photos meet */
  .w5 { width: 256px; left: calc(50% - 128px); top: 22%; opacity: 0.5; background: var(--color-accent); -webkit-mask: var(--wash) center / 100% 100% no-repeat; mask: var(--wash) center / 100% 100% no-repeat; transform: rotate(-8deg); }
  .collage[data-accent='peach'] .w4 { background: var(--color-peach); opacity: 0.9; right: 8px; bottom: -4%; }
  .row { display: flex; align-items: center; position: relative; z-index: var(--z); }
  .row.left { justify-content: flex-start; }
  .row.right { justify-content: flex-end; }
  .row.mid { justify-content: center; }
  .row + .row { margin-top: calc(-1 * var(--ov)); }   /* rows tuck over the one above */
  .piece { width: var(--w); transform: rotate(var(--tilt)); position: relative; flex: none; }
  .row.mid .piece + .piece { margin-left: -12%; }      /* pairs overlap sideways, so the cluster stays one shape */
  .piece.piece :global(.fig) { margin-block: 0; }
  .piece :global(img) { object-position: var(--pos); }
</style>
