---
// The "invitation letter" treatment: thin diamond rules above and below, a tracked-caps heading, a soft blue wash behind, centered heading.
// Used for the top section of Our Story (the Home letter has its own copy with a drop cap and signature).
import Flourish from './Flourish.astro';
interface Props { title: string; }
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
---
<div class="letter" style={`--wash:url(${base}images/wash-smudge.webp)`}>
  <Flourish />
  <h2 class="caps-lg">{Astro.props.title}</h2>
  <slot />
  <Flourish />
</div>

<style>
  /* .letter.letter outranks Section's `* + *` spacing */
  .letter.letter { position: relative; padding: var(--space-4) 0; display: flow-root; margin-block: 0; }
  .letter::before { content: ''; position: absolute; inset: 0 -32px; z-index: -1; background: var(--wash) center / 100% 100% no-repeat; mix-blend-mode: multiply; opacity: 0.22; pointer-events: none; }
  .letter > :global(* + *) { margin-top: var(--flow); }
  .letter h2 { text-align: center; font-weight: 400; }
  .caps-lg { font-family: var(--font-serif); text-transform: uppercase; letter-spacing: var(--tracking-caps-wide); margin-right: calc(-1 * var(--tracking-caps-wide)); line-height: 1.4; font-size: var(--text-caps-lg); color: var(--color-text); }
  .letter :global(em) { display: block; text-align: center; }
</style>
