---
// Short info block: a heading (title) with an optional eyebrow above it, then a paragraph.
// Eyebrows are short category labels (<= ~5 words); a block with no eyebrow just has its heading.
interface Props { title: string; eyebrow?: string; note?: string; }
const { title, eyebrow, note } = Astro.props;
---
<div class="info">
  {eyebrow && <p class="eyebrow">{eyebrow}</p>}
  <h3 class="subhead-sm">{title}</h3>
  <p><slot /></p>
  {note && <p><em>{note}</em></p>}
</div>

<style>
  .info { position: relative; padding-left: var(--space-3); }
  /* Diamond marker, centered on the heading's first line */
  .info::before { content: ''; position: absolute; left: 2px; top: 12px; width: 6px; height: 6px; background: var(--color-accent); transform: rotate(45deg); } /* grid-exempt: marker geometry */
  .info > :global(* + *) { margin-top: var(--space-1); }
</style>
