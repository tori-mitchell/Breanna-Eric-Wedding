---
// Hand-sketched double frame around a photo. `tilt` in degrees.
interface Props { tilt?: number; width?: string; align?: 'left' | 'right' | 'center'; }
const { tilt = 0, width = '86%', align = 'center' } = Astro.props;
---
<div class="frame" data-a={align} style={`--tilt:${tilt}deg;--w:${width}`}>
  <slot />
</div>

<style>
  .frame {
    position: relative; width: var(--w); padding: 2rem;
    transform: rotate(var(--tilt));
  }
  .frame[data-a='center'] { margin-inline: auto; }
  .frame[data-a='right'] { margin-left: auto; }
  .frame::before, .frame::after {
    content: ''; position: absolute; border: 2px solid var(--color-frame);
    filter: url(#sketch); pointer-events: none;
  }
  .frame::before { inset: 0; }
  .frame::after { inset: 0.5rem; border-width: 1.5px; opacity: 0.85; }
</style>
