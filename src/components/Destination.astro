---
// Explore-page destination: eyebrow (place name), heading (tagline), copy, then plain-text stay and favorites.
interface Props { eyebrow: string; name: string; stay: string; favorites?: string; align?: 'left'; artFirst?: boolean; wash?: 'left' | 'right'; accent?: 'sage' | 'peach'; artLabel?: string; artSrc?: string; flip?: boolean; rows?: number; }
const { eyebrow, name, stay, favorites, align = 'left', artFirst = false, wash = 'right', accent = 'sage', artLabel = 'Watercolor', artSrc, flip = false, rows = 6 } = Astro.props;
import Section from './Section.astro';
import Figure from './Figure.astro';
---
<Section align={align} wide split flip={flip} rows={rows}>
  <p class="eyebrow">{name}</p>
  <h2 class="subhead">{eyebrow}</h2>
  {artFirst && <Figure art wash={wash} accent={accent} src={artSrc} ratio="4 / 5" label={artLabel} />}
  <slot />
  <p><em>{stay}</em></p>
  {favorites && <p>A few favorites: {favorites.split(' • ').map((f, i, all) => <><span class="fav">{f}{i < all.length - 1 && <span class="dia" aria-hidden="true" />}</span>{' '}</>)}</p>}
  <slot name="note" />
  {!artFirst && <Figure art wash={wash} accent={accent} src={artSrc} ratio="4 / 5" label={artLabel} />}
</Section>

<style>
  /* Diamond separator between list items (same marker as the info-block bullets) */
  .fav { white-space: nowrap; }
  .dia { display: inline-block; width: 5px; height: 5px; margin: 0 8px 3px 12px; background: var(--color-accent); transform: rotate(45deg); vertical-align: middle; } /* grid-exempt: marker geometry */
</style>
