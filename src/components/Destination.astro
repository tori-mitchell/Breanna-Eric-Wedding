---
// Explore-page destination: eyebrow, name, copy, suggested stay, favorites, note, art.
interface Props { eyebrow: string; name: string; stay: string; favorites?: string; align?: 'left'; artFirst?: boolean; artLabel?: string; artSrc?: string; }
const { eyebrow, name, stay, favorites, align = 'left', artFirst = false, artLabel = 'Watercolor', artSrc } = Astro.props;
import Section from './Section.astro';
import Figure from './Figure.astro';
---
<Section align={align}>
  <p class="eyebrow">{eyebrow}</p>
  <h2 class="subhead">{name}</h2>
  {artFirst && <Figure art src={artSrc} ratio="4 / 5" label={artLabel} />}
  <slot />
  <p><em>{stay}</em></p>
  {favorites && <>
    <p class="eyebrow fav">A few favorites</p>
    <p>{favorites}</p>
  </>}
  <slot name="note" />
  {!artFirst && <Figure art src={artSrc} ratio="4 / 5" label={artLabel} />}
</Section>

<style>
  .fav { margin-top: var(--space-3); }
</style>
