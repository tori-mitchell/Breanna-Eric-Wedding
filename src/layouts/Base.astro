---
import '../styles/global.css';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';

interface Props { title: string; description?: string; }
const { title, description = 'Breanna & Eric — September 16–19, 2027, Borgo Laticastelli, Tuscany' } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="robots" content="noindex, nofollow" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#f7f3ee" />
    <script is:inline>document.documentElement.classList.add('js')</script>
    <title>{title}</title>
    <link rel="icon" href={`${base}favicon.svg`} type="image/svg+xml" />
  </head>
  <body>
    <svg width="0" height="0" style="position:absolute" aria-hidden="true" focusable="false">
      <filter id="temp-tint" color-interpolation-filters="sRGB"><feColorMatrix type="matrix" values="0.3 0.6 0.1 0 0  0.06 0.12 0.02 0 0  0.3 0.6 0.1 0 0  0 0 0 1 0" /></filter>
      <filter id="sketch"><feTurbulence type="fractalNoise" baseFrequency="0.015" numOctaves="2" seed="4" /><feDisplacementMap in="SourceGraphic" scale="4" /></filter>
    </svg>
    <Nav />
    <main><slot /></main>
    <p class="to-top"><a class="more to-top-link" href="#top">Back to top &#8593;&#xFE0E;</a></p>
    <Footer />
    <script>
      const els = document.querySelectorAll('.reveal');
      if ('IntersectionObserver' in window) {
        const io = new IntersectionObserver((entries) => {
          entries.forEach((e) => { if (e.isIntersecting) { e.target.classList.add('is-visible'); io.unobserve(e.target); } });
        }, { threshold: 0.15 });
        els.forEach((el) => io.observe(el));
      } else els.forEach((el) => el.classList.add('is-visible'));
    </script>
  </body>
</html>
<style>
  .to-top { text-align: center; margin: var(--block) 0 0; }
</style>

<script>
  // Back to top: a slow, eased glide (about 1.1s, ease-in-out) instead of an instant jump. Reduced-motion users jump.
  const link = document.querySelector('.to-top-link');
  link?.addEventListener('click', (e) => {
    e.preventDefault();
    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const start = window.scrollY;
    if (reduce || start < 4) { window.scrollTo(0, 0); return; }
    const dur = Math.min(1400, 700 + start * 0.1);
    const t0 = performance.now();
    const ease = (t: number) => (t < 0.5 ? 4 * t * t * t : 1 - Math.pow(-2 * t + 2, 3) / 2);  // cubic in-out
    const step = (now: number) => {
      const t = Math.min(1, (now - t0) / dur);
      window.scrollTo(0, start * (1 - ease(t)));
      if (t < 1) requestAnimationFrame(step);
      else (document.querySelector('.bar .brand') as HTMLElement | null)?.focus({ preventScroll: true });
    };
    requestAnimationFrame(step);
  });
</script>
