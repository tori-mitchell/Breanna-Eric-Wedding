---
import Base from '../layouts/Base.astro';
import d1 from '../assets/dividers/d1.svg?raw';
import d2 from '../assets/dividers/d2.svg?raw';
import d3 from '../assets/dividers/d3.svg?raw';
const opts = [['1', 'Scroll curls', d1], ['2', 'Swash', d2], ['3', 'Vine', d3]];
---
<Base title="Divider options">
  <section class="wrap">
    <p class="eyebrow">Divider options</p>
    {opts.map(([k, name, svg]) => (
      <div class="opt">
        <p class="eyebrow">{k} · {name}</p>
        <div class="rule" set:html={svg} />
      </div>
    ))}
  </section>
</Base>
<style>
  .wrap { padding: var(--space-4) var(--gutter); display: grid; gap: var(--space-4); }
  .opt { display: grid; gap: var(--space-2); text-align: center; }
  .rule { color: var(--color-accent); }
  .rule :global(svg) { width: 100%; max-width: 320px; height: auto; margin-inline: auto; display: block; }
</style>
