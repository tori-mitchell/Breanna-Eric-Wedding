---
import Base from '../layouts/Base.astro';
import PageTitle from '../components/PageTitle.astro';
import Section from '../components/Section.astro';
import ScheduleRow from '../components/ScheduleRow.astro';
import Figure from '../components/Figure.astro';
import Flourish from '../components/Flourish.astro';
import { itinerary } from '../data/itinerary';
import { daily, showDaily } from '../data/daily';
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
---
<Base title="Itinerary — Breanna & Eric">
  <PageTitle title="Itinerary" />
  <Section>
    {itinerary.map((d, i) => <ScheduleRow dow={d.dow} date={d.date} title={d.title} href={showDaily ? `#day-${i + 1}` : undefined}>{d.desc}</ScheduleRow>)}
    <p class="after"><em>Times will be added here as they’re finalized. More questions? See the <a href={`${base}faq/`}>FAQ</a>.</em></p>
    <Figure narrow wash="right" accent="sage" ratio="2 / 3" label="Placeholder image" />
  </Section>

  <Flourish spaced />

  {showDaily ? (
    daily.map((d, i) => (
      <Section id={`day-${i + 1}`}>
        <p class="eyebrow">{d.title}</p>
        <h2 class="subhead">{d.date}</h2>
        <div class="day">
          {d.rows.map((r) => <ScheduleRow time={r.time} title={r.title}>{r.desc}</ScheduleRow>)}
        </div>
        <Figure narrow wash={i % 2 ? 'right' : 'left'} accent={i % 2 ? 'peach' : 'sage'} soft={d.soft} src={d.img} ratio="4 / 5" label={d.imgLabel} />
      </Section>
    ))
  ) : (
    <Section align="center">
      <p class="eyebrow">Daily schedules</p>
      <h2 class="subhead">Details coming soon</h2>
      <p>We’re still putting the day-by-day plans together. The full schedule with times will be shared here closer to the wedding.</p>
    </Section>
  )}
</Base>

<style>
  .day { margin-top: var(--flow); }
  p a { text-decoration: underline; text-underline-offset: 4px; }
  /* The closing note is its own block: 48px below the list (never closer than 24px). */
  p.after { margin-top: var(--block); }
</style>
