---
import Base from '../layouts/Base.astro';
import PageTitle from '../components/PageTitle.astro';
import Section from '../components/Section.astro';
import ScheduleRow from '../components/ScheduleRow.astro';
import Figure from '../components/Figure.astro';
import Flourish from '../components/Flourish.astro';
import { itinerary } from '../data/itinerary';
import { daily } from '../data/daily';
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
---
<Base title="Itinerary — Breanna & Eric">
  <PageTitle title="Itinerary" />
  <Section>
    {itinerary.map((d, i) => <ScheduleRow dow={d.dow} date={d.date} title={d.title} href={`#day-${i + 1}`}>{d.desc}</ScheduleRow>)}
    <p class="after"><em>Times will be added here as they’re finalized. More questions? See the <a href={`${base}faq/`}>FAQ</a>.</em></p>
  </Section>

  <Flourish spaced />

  {daily.map((d, i) => (
    <Section id={`day-${i + 1}`}>
      <h2 class="subhead">{d.title}</h2>
      <p class="eyebrow dayline">{d.date}</p>
      <div class="day">
        {d.rows.map((r) => <ScheduleRow time={r.time} title={r.title}>{r.desc}</ScheduleRow>)}
      </div>
      <Figure wash={i % 2 ? 'right' : 'left'} accent={i % 2 ? 'peach' : 'sage'} ratio="3 / 2" label="Placeholder image" />
    </Section>
  ))}
</Base>

<style>
  .day { margin-top: var(--flow); }
  .dayline.dayline { margin-top: var(--space-1); }   /* date line sits 8px under the heading */
  p a { text-decoration: underline; text-underline-offset: 4px; }
  /* The closing note is its own block: 48px below the list (never closer than 24px). */
  p.after { margin-top: var(--block); }
</style>
