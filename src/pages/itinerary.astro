---
import Base from '../layouts/Base.astro';
import PageTitle from '../components/PageTitle.astro';
import Section from '../components/Section.astro';
import ScheduleRow from '../components/ScheduleRow.astro';
import { itinerary } from '../data/itinerary';
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
---
<Base title="Itinerary — Breanna & Eric">
  <PageTitle title="Itinerary" />
  <Section>
    {itinerary.map((d) => <ScheduleRow dow={d.dow} date={d.date} title={d.title}>{d.desc}</ScheduleRow>)}
    <p class="after"><em>Times will be added here as they’re finalized. More questions? See the <a href={`${base}faq/`}>FAQ</a>.</em></p>
  </Section>
</Base>

<style>
  p a { text-decoration: underline; text-underline-offset: 4px; }
  /* The closing note is its own block: 48px below the list (never closer than 24px). */
  p.after { margin-top: var(--block); }
</style>
