---
import Base from '../layouts/Base.astro';
const colors = [
  ['--color-bg', 'Background'],
  ['--color-text', 'Text'],
  ['--color-label', 'Eyebrow'],
  ['--color-frame', 'Frames & rules'],
];
const specs = [
  ['Script hero', '--text-script-hero', 'Pinyon Script'],
  ['Script header', '--text-script-header', 'Pinyon Script'],
  ['Lead', '--text-lead', 'EB Garamond'],
  ['Subhead', '--text-subhead', 'EB Garamond 600'],
  ['Eyebrow', '--text-eyebrow', 'Jost 500, caps, 2px'],
  ['Body', '--text-body', 'EB Garamond (also nav, footer)'],
];
---
<Base title="Style guide">
  <div class="page guide">
    <p class="gh">Internal reference — not linked from the site</p>

    <p class="gh">Text styles</p>
    <p class="script hero">Script hero</p>
    <p class="script">Script header</p>
    <p class="lead">Lead — intro paragraphs and the hero date.</p>
    <p class="subhead">Subhead</p>
    <p class="eyebrow">Eyebrow</p>
    <p>Body — We’re so happy you’re here. More than anything, we wanted our wedding to feel like time set aside with the people we love most.</p>
    <p><em>Body italic — an em inside body text, for notes like “details will be shared closer to the wedding.”</em></p>

    <p class="gh">Color</p>
    <ul class="swatches">
      {colors.map(([v, name]) => (
        <li><span class="chip" style={`background:var(${v})`}></span>{name}</li>
      ))}
    </ul>

    <p class="gh">Tokens</p>
    <table>
      {specs.map(([name, token, font]) => <tr><td>{name}</td><td><code>{token}</code></td><td><code>{font}</code></td></tr>)}
      {colors.map(([v, name]) => <tr><td>{name}</td><td><code>{v}</code></td><td></td></tr>)}
    </table>
    <p><code>src/styles/tokens.css</code></p>
  </div>
</Base>

<style>
  .guide { padding-block: var(--space-4); max-width: var(--measure); margin-inline: auto; }
  .guide > * + * { margin-top: var(--space-3); }
  .guide .lead { text-align: left; }
  .hero { font-size: var(--text-script-hero); }
  .gh { margin-top: var(--space-5) !important; padding-top: var(--space-1); border-top: 1px solid var(--color-rule);
    font: 0.75rem/1.2 ui-monospace, Menlo, monospace; letter-spacing: 0.08em; text-transform: uppercase; opacity: 0.7; }
  .swatches { list-style: none; padding: 0; display: grid; gap: var(--space-1); }
  .swatches li { display: flex; align-items: center; gap: var(--space-2); }
  .chip { width: 2.5rem; height: 2.5rem; border: 1px solid var(--color-rule); }
  table { font-size: 0.85rem; border-collapse: collapse; width: 100%; }
  td { padding: 0.3rem 0.75rem 0.3rem 0; vertical-align: top; }
  code { font-size: 0.78rem; opacity: 0.75; }
</style>
