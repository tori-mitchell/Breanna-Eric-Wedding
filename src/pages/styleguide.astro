---
import Base from '../layouts/Base.astro';
const colors = [
  ['--color-bg', 'Background'],
  ['--color-text', 'Text / headings'],
  ['--color-label', 'Eyebrow'],
  ['--color-frame', 'Frames & rules'],
];
const styles = [
  ['--text-script-hero', 'Script hero'],
  ['--text-script-header', 'Script header'],
  ['--text-lead', 'Lead'],
  ['--text-subhead', 'Subhead'],
  ['--text-body', 'Body (also nav, footer, small text)'],
  ['--text-eyebrow', 'Eyebrow'],
];
---
<Base title="Style guide">
  <div class="page guide stack">
    <h1>Style guide</h1>
    <p><em>Internal reference — not linked from the site. Tokens live in <code>src/styles/tokens.css</code>.</em></p>

    <h2>Color</h2>
    <ul class="swatches">
      {colors.map(([v, name]) => (
        <li><span class="chip" style={`background:var(${v})`}></span><b>{name}</b><code>{v}</code></li>
      ))}
    </ul>

    <h2>Text styles</h2>
    <p class="eyebrow">Script hero</p>
    <p class="script" style="font-size:var(--text-script-hero)">Breanna &amp; Eric</p>
    <p class="eyebrow">Script header</p>
    <p class="script">How We Met</p>
    <p class="eyebrow">Lead</p>
    <p class="lead">Getting to the Tuscan countryside takes a little planning.</p>
    <p class="eyebrow">Subhead</p>
    <p class="subhead">Sorrento</p>
    <p class="eyebrow">Eyebrow (chapters, labels, dates)</p>
    <p class="eyebrow">Saturday, September 18, 2027</p>
    <p class="eyebrow">Body</p>
    <p>We’re so happy you’re here. More than anything, we wanted our wedding to feel like time set aside with the people we love most.</p>
    <p><em>Italic is just body with &lt;em&gt;: Departure and transfer details will be shared closer to the wedding.</em></p>

    <h2>Alignment</h2>
    <div data-align="right"><p class="eyebrow">Chapter One</p><h2>How We Met</h2><p>Right-aligned section for alternating layouts.</p></div>

    <h2>Sizes</h2>
    <table>
      {styles.map(([s, name]) => <tr><td><code>{s}</code></td><td>{name}</td></tr>)}
    </table>
  </div>
</Base>

<style>
  .guide { padding-block: var(--space-4); max-width: var(--measure); margin-inline: auto; }
  .swatches { list-style: none; padding: 0; display: grid; gap: var(--space-1); }
  .swatches li { display: flex; align-items: center; gap: var(--space-2); }
  .chip { width: 2.5rem; height: 2.5rem; border: 1px solid var(--color-rule); }
  code { font-size: 0.8rem; opacity: 0.7; }
  td { padding: 0.25rem 1rem 0.25rem 0; }
</style>
