---
import Base from '../layouts/Base.astro';
import PageTitle from '../components/PageTitle.astro';
import Section from '../components/Section.astro';
import ScheduleRow from '../components/ScheduleRow.astro';
import FaqItem from '../components/FaqItem.astro';
import Info from '../components/Info.astro';
import Destination from '../components/Destination.astro';
import Step from '../components/Step.astro';
import Frame from '../components/Frame.astro';
import Figure from '../components/Figure.astro';
const colors = [
  ['--color-bg', 'Background'],
  ['--color-text', 'Ink (headings, nav, eyebrows)'],
  ['--color-body', 'Body text (lighter)'],
  ['--color-detail', 'Details (paler still)'],
  ['--color-accent', 'Accent (special places)'],
  ['--color-rule', 'Dividers'],
];
const specs = [
  ['Hero names', '--text-caps-name', 'EB Garamond caps, tracked .22em'],
  ['Caps detail', '--text-caps-lg / --text-caps', 'EB Garamond caps, tracked .24em'],
  ['Script small', '--text-script-sm', 'Pinyon Script (intro, venue)'],
  ['Script header', '--text-script-header', 'Pinyon Script'],
  ['Subhead', '--text-subhead', 'EB Garamond 600'],
  ['Subhead small', '--text-subhead-sm', 'EB Garamond 600'],
  ['Eyebrow', '--text-eyebrow', 'Jost 400, caps, 3px tracking'], // grid-exempt
  ['Body', '--text-body', 'Lora'],
  ['Small', '--text-small', 'Lora, paler (details)'],
  ['Italic', '--text-italic-scale', 'Newsreader italic, ×1.11 to match Lora'],
];
---
<Base title="Style guide">
  <div class="page guide">
    <p class="gh">Internal reference — not linked from the site</p>

    <p class="gh">Text styles</p>
    <p class="hero-name">Hero names</p>
    <p class="caps-d">September 16 – 19, 2027</p>
    <p class="script small">the wedding of</p>
    <p class="script">Script header</p>
    <p><em>Script is special: page titles, hero names, signature, short chapter titles. Never for long sentences.</em></p>
    <p class="subhead">Subhead</p>
    <p class="subhead-sm">Subhead small</p>
    <p class="eyebrow">Eyebrow</p>
    <p>Body — We’re so happy you’re here. More than anything, we wanted our wedding to feel like time set aside with the people we love most.</p>
    <p>Italic is a different family: a note like <em>“details will be shared closer to the wedding”</em> inside a sentence.</p>
    <p class="small">Small — details such as itinerary descriptions and FAQ answers, in a paler tone. Check-in begins at 3:00 PM.</p>
    <p><em>An italic-only paragraph is automatically Small, like this note about the household.</em></p>

    <p class="gh">Color</p>
    <ul class="swatches">
      {colors.map(([v, name]) => (
        <li><span class="chip" style={`background:var(${v})`}></span>{name}</li>
      ))}
    </ul>

    <p class="gh">Tokens</p>
    <table>
      {specs.map(([name, token, font]) => <tr><td>{name}</td><td><code>{token}</code></td><td><code>{font}</code></td></tr>)}
      {colors.map(([v, name]) => <tr><td>{name}</td><td><code>{v}</code></td><td></td></tr>)}
    </table>
    <p><code>src/styles/tokens.css</code></p>

    <p class="gh">Patterns — as used on the pages</p>

    <p class="gh sub">Page title + intro (all pages)</p>
    <div class="demo bleed">
      <PageTitle title="The Journey" />
      <Section align="center"><p>Getting to the Tuscan countryside takes a little planning, but you will not need a rental car for the wedding weekend.</p></Section>
    </div>

    <p class="gh sub">Home hero</p>
    <div class="demo" data-align="center">
      <p class="script small">the wedding of</p>
      <p class="hero-name">Breanna</p><p class="script amp">&amp;</p><p class="hero-name">Eric</p>
      <p class="caps-d">September 16 – 19, 2027</p>
      <p class="script small">Borgo Laticastelli</p>
    </div>

    <p class="gh sub">Chapter / text section</p>
    <div class="demo">
      <Section>
        <p class="eyebrow">Chapter Two</p>
        <h2 class="script">Life Together</h2>
        <p>After ZincHouse came a lot more dates, and then Eric got a dog.</p>
        <p>Breanna quickly became part of the training process, and before long their lives were weaving together.</p>
        <p><em>New places, good company, our favorite kind of adventure.</em></p>
      </Section>
    </div>

    <p class="gh sub">Schedule rows (Itinerary)</p>
    <div class="demo">
      <Section>
        <ScheduleRow dow="Sat" date="Sep 18" title="Wedding Day">Ceremony and celebration at Laticastelli. Timing and dress details will be shared with the invitation.</ScheduleRow>
        <ScheduleRow dow="Sun" date="Sep 19" title="Departure">One last slow morning, with breakfast. Checkout is by 12:00 PM.</ScheduleRow>
      </Section>
    </div>

    <p class="gh sub">FAQ items</p>
    <div class="demo">
      <Section>
        <FaqItem q="When are check-in and checkout?">Check-in begins at 3:00 PM on Thursday. Checkout is by 12:00 PM on Sunday.</FaqItem>
        <FaqItem q="Do I need a rental car?">Not for the wedding weekend.</FaqItem>
      </Section>
    </div>

    <p class="gh sub">Destination block (Explore)</p>
    <div class="demo">
      <Destination eyebrow="For coast & sunshine" name="Sorrento" stay="Suggested stay: 3–4 nights"
        favorites="Capri • Pompeii • Positano/Amalfi Coast • Marina Grande" artLabel="Watercolor">
        <p>For a few days by the water, Sorrento lets you slow down in town, with the Bay of Naples and the Amalfi Coast close by when you want them.</p>
        <p slot="note"><em>Sorrento is farther from Tuscany, so think of it as a true trip extension.</em></p>
      </Destination>
    </div>

    <p class="gh sub">Info blocks (Travel)</p>
    <div class="demo">
      <Section>
        <h2>Choosing an Airport</h2>
        <Info title="Florence">Florence is the simplest option once you are on the ground.</Info>
        <Info title="Money">Italy uses the euro. Credit cards are widely used, but it is helpful to carry some cash.</Info>
      </Section>
    </div>

    <p class="gh sub">Numbered steps (Travel)</p>
    <div class="demo">
      <Section align="center">
        <h2 class="subhead">The Simple Version</h2>
        <ol class="steps">
          <Step n="01" title="Fly"><p>Fly into Florence, Rome, or Pisa.</p></Step>
          <Step n="02" title="Train"><p>Continue by train to Rapolano Terme.</p></Step>
        </ol>
      </Section>
    </div>

    <p class="gh sub">Framed photo (Our Story)</p>
    <div class="demo">
      <Frame tilt={-3} width="78%"><Figure src="images/placeholders/parade.jpg" ratio="3 / 4" label="Photo" /></Frame>
    </div>
  </div>
</Base>

<style>
  .guide { padding-block: var(--space-4); max-width: var(--measure); margin-inline: auto; }
  .guide > * + * { margin-top: var(--space-3); }
  .hero-name { font-family: var(--font-serif); font-size: var(--text-caps-name); letter-spacing: var(--tracking-name); text-transform: uppercase; color: var(--color-text); }
  .caps-d { font-family: var(--font-serif); font-size: var(--text-caps-lg); letter-spacing: var(--tracking-caps-wide); text-transform: uppercase; }
  .script.small { font-size: var(--text-script-sm); color: var(--color-accent); }
  .script.amp { font-size: var(--text-script-amp); color: var(--color-accent); line-height: 1; }
  .gh { margin-top: var(--space-5) !important; padding-top: var(--space-1); border-top: 1px solid var(--color-rule);
    font: 0.75rem/1.2 ui-monospace, Menlo, monospace; letter-spacing: 0.08em; text-transform: uppercase; opacity: 0.7; }
  .swatches { list-style: none; padding: 0; display: grid; gap: var(--space-1); }
  .swatches li { display: flex; align-items: center; gap: var(--space-2); }
  .chip { width: 2.5rem; height: 2.5rem; border: 1px solid var(--color-rule); }
  table { font-size: 0.75rem; border-collapse: collapse; width: 100%; }
  td { padding: 0.25rem 0.75rem 0.25rem 0; vertical-align: top; }
  code { font-size: 0.75rem; opacity: 0.75; }
  .gh.sub { border-top: 0; margin-top: var(--space-4) !important; opacity: 0.55; }
  .demo { border: 1px dashed var(--color-rule); padding: var(--space-2) 0; overflow: hidden; }
  .steps { padding: 0; margin: var(--space-3) auto 0; max-width: 24rem; }
  .demo.bleed { padding: 0; }
</style>
