---
import Base from '../layouts/Base.astro';
import PageTitle from '../components/PageTitle.astro';
import Section from '../components/Section.astro';
import Event from '../components/Event.astro';
---
<Base title="Our Weekend — Breanna & Eric">
  <PageTitle title="Our Weekend" />
  <Section align="center">
    <p class="lead">Four days together at Borgo Laticastelli, from a quiet arrival through one last slow morning.</p>
  </Section>

  <Event date="Thursday, September 16, 2027" title="Arrival" align="right" artPos="above" artLabel="Watercolor: villa arrival"
    note="Arrival and transfer details will be shared closer to the wedding.">
    Arrive, settle in, and ease into the weekend at Laticastelli.
  </Event>

  <Event date="Friday, September 17, 2027" title="Welcome" artLabel="Watercolor: pool terrace"
    note="Timing and dress details will be shared with the formal invitation.">
    A relaxed day together before the wedding day.
  </Event>

  <Event date="Saturday, September 18, 2027" title="Wedding Day" align="right" artPos="above" artLabel="Watercolor: ceremony"
    note="Full timing and dress details will be shared with the formal invitation.">
    The ceremony and celebration will take place at Laticastelli.
  </Event>

  <Event date="Sunday, September 19, 2027" title="A Slow Morning" artLabel="Watercolor: terrace with coffee"
    note="Departure and transfer details will be shared closer to the wedding.">
    One last morning together before everyone heads off into Italy.
  </Event>
</Base>
