---
import Base from '../layouts/Base.astro';
---
<Base title="Breanna & Eric" fullScreen>
  <section class="page hero" data-align="center">
    <p class="eyebrow">The wedding of</p>
    <h1>Breanna<br />&amp; Eric</h1>
    <div class="when">
      <p class="date">September 16<sup>th</sup> to 19<sup>th</sup> 2027</p>
      <p class="loc"><em>Borgo Laticastelli, Tuscany, Italy</em></p>
    </div>
    <!-- TODO: hero watercolor background (CONTENT-TODO §3) -->
  </section>
</Base>

<style>
  /* Home never scrolls: nav stays at the top, footer at the bottom, and the three
     chunks (eyebrow / names / date+location) spread evenly between them, so every
     gap flexes with the phone's height. The h1 margins nudge gaps optically (the
     script's flourishes eat into the space around the names). */
  .hero { flex: 1; min-height: 0; display: flex; flex-direction: column; justify-content: space-evenly; }
  /* Optical offsets (flourishes, line-box padding) so the four visible gaps read as equal */
  h1 { font-size: var(--text-script-hero); line-height: var(--leading-hero); margin: 20px 0 8px; }
  .when { margin-bottom: 24px; }
  .date { font-size: var(--text-subhead); line-height: var(--leading-subhead); }
  sup { font-size: 0.5em; }
  .loc { margin-top: 1rem; }

  /* Shorter screens: step the type down so everything still fits without scrolling */
  @media (max-height: 720px) {
    h1 { font-size: 3.5rem; line-height: 48px; }   /* 56px / 48px */
    .date { font-size: 1.5rem; line-height: 32px; }  /* 24px / 32px */
    .loc { margin-top: 0.5rem; }
  }
  @media (max-height: 600px) {
    h1 { font-size: 3rem; line-height: 40px; }
  }
</style>
