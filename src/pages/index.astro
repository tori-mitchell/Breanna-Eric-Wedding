---
import Base from '../layouts/Base.astro';
---
<Base title="Breanna & Eric">
  <section class="page hero" data-align="center">
    <p class="eyebrow">The wedding of</p>
    <h1>Breanna<br />&amp; Eric</h1>
    <p class="date">September 16<sup>th</sup> to 19<sup>th</sup> 2027</p>
    <p class="loc"><em>Borgo Laticastelli, Tuscany, Italy</em></p>
    <!-- TODO: hero watercolor background (CONTENT-TODO §3) -->
  </section>
</Base>

<style>
  /* Three chunks (eyebrow / names / date+location), spaced to look equidistant.
     Gaps are tuned optically against the script's flourishes, not equal margins. */
  .hero { --gap-eyebrow: 2.9rem; --gap-names: 2.4rem; padding-block: var(--space-5); }
  h1 { font-size: var(--text-script-hero); line-height: var(--leading-hero); margin: var(--gap-eyebrow) 0 var(--gap-names); }
  .date { font-size: var(--text-subhead); line-height: 1.1; }
  sup { font-size: 0.55em; }
  .loc { margin-top: 0.625rem; }
</style>
