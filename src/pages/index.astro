---
import Base from '../layouts/Base.astro';
---
<Base title="Breanna & Eric" fullScreen>
  <section class="page hero" data-align="center">
    <p class="eyebrow">The wedding of</p>
    <h1>Breanna<br />&amp; Eric</h1>
    <div class="when">
      <p class="date">September 16<sup>th</sup> to 19<sup>th</sup> 2027</p>
      <p class="loc"><em>Borgo Laticastelli, Tuscany, Italy</em></p>
    </div>
    <!-- TODO: hero watercolor background (CONTENT-TODO §3) -->
  </section>
</Base>

<style>
  /* Home never scrolls: nav pinned top, footer pinned bottom. The hero is one container
     (eyebrow / names / date+location, 64px apart) centered in the space between them.
     Date+location is its own container with an 8px gap. */
  .hero { flex: 1; min-height: 0; display: flex; flex-direction: column; justify-content: center; gap: 64px; }
  .when { display: flex; flex-direction: column; gap: 8px; }
  h1 { font-size: var(--text-script-hero); line-height: var(--leading-hero); }
  .date { font-size: var(--text-subhead); line-height: var(--leading-subhead); }
  sup { font-size: 0.5em; }

  /* Shorter screens: step the type down so everything still fits without scrolling */
  @media (max-height: 720px) {
    .hero { gap: 40px; }
    h1 { font-size: 3.5rem; line-height: 48px; }
    .date { font-size: 1.5rem; line-height: 32px; }
  }
  @media (max-height: 600px) {
    .hero { gap: 24px; }
    h1 { font-size: 3rem; line-height: 40px; }
  }
</style>
