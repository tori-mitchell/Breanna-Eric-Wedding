---
import Base from '../layouts/Base.astro';
import Section from '../components/Section.astro';
import BlockPhoto from '../components/BlockPhoto.astro';
import Button from '../components/Button.astro';
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
const art = (n) => `${base}images/placeholders/${n}.jpg`;
import Flourish from '../components/Flourish.astro';
---
<Base title="Breanna & Eric">
  <section class="page hero" data-align="center">
    <!-- Hero watercolor fills the first screen, behind the glass nav. Placeholder: Canva hero with the text erased (CONTENT-TODO §3). -->
    <img class="art" src={art('art-hero-full')} alt="" data-temp />
    <p class="caps">the wedding of</p>
    <h1 class="names"><span class="nm">Breanna</span> <span class="amp">&amp;</span> <span class="nm">Eric</span></h1>
    <div class="when">
      <p class="caps-lg">September 16 – 19, 2027</p>
      <p class="script-sm">Borgo Laticastelli</p>
      <p class="caps">Tuscany, Italy</p>
    </div>
  </section>

  <Section>
    <BlockPhoto src="images/placeholders/home-couple.jpg" label="Photo: couple" variant="left" />
    <div class="letter" style={`--wash:url(${base}images/wash-smudge.webp)`}>
      <Flourish />
      <h2 class="script">You’re invited!</h2>
      <p class="dropcap">It means so much to us to have the people we love joining us in Tuscany for this weekend. We’ve put this little corner together to keep everything in one place, from where to stay and how to get there to what we’ll be doing once we’re all together.</p>
      <p>More than anything, we hope these few days feel like time to slow down, settle in, and celebrate with us. We can’t wait for long dinners, late nights, lots of laughter, and the kind of memories we’ll be talking about for years.</p>
      <p>With all our love,</p>
      <p class="script sig">Breanna &amp; Eric</p>
      <Flourish />
    </div>
  </Section>

  <Section>
    <h2 class="subhead">This is where our forever begins</h2>
    <p>For a few days, Borgo Laticastelli will become a little world of our own. The people we love most will be staying together here, waking up in the same village, wandering the same stone paths, and sharing all of the quiet moments in between the plans.</p>
    <p>Dating back to the 12th century, Laticastelli is a restored Tuscan borgo overlooking the Crete Senesi. Its name is said to mean “the castle where light comes from all sides,” which feels especially fitting for the place where this next chapter begins.</p>
    <p>The borgo will be reserved exclusively for our group. More than anything, we love the idea that for one weekend, everyone we care about will get to settle in, slow down, and experience it all together.</p>
    <BlockPhoto src="images/placeholders/home-lane.jpg" label="Photo: borgo lane" variant="right" />
  </Section>

  <Section>
    <img class="sprig tr wc wc-landscape" src={art('art-sprig-r')} alt="" data-temp />
    <p class="eyebrow">RSVP</p>
    <h2 class="subhead">Already know you can’t make it?</h2>
    <p>We completely understand that traveling to Tuscany won’t be possible for everyone. If you already know you won’t be able to join us, you’re welcome to let us know now. For everyone else, formal RSVP details will be shared with the invitation.</p>
    <p><Button href="#">Let us Know</Button></p>
  </Section>

  <Section>
    <img class="sprig br wc wc-landscape" src={art('art-sprig-r2')} alt="" data-temp />
    <p class="eyebrow">Registry</p>
    <h2 class="subhead">For the Years Ahead</h2>
    <p>The greatest gift is having you there to celebrate with us. For those who have asked, we’ve created a registry filled with a few things we’d love for the home and life we’re continuing to build together.</p>
    <p><Button href="#">View our Registry</Button></p>
  </Section>
</Base>

<style>
  /* Invitation letter: wash behind, thin flourish rules above and below, storybook drop cap that hugs the text.
     initial-letter (Safari, Chromium) aligns the cap to the text lines exactly; Firefox lacks it, so a tuned float stands in. */
  .letter { position: relative; padding: var(--space-4) 0; display: flow-root; }
  .letter::before { content: ''; position: absolute; inset: 0 -32px; z-index: -1; background: var(--wash) center / 100% 100% no-repeat; mix-blend-mode: multiply; opacity: 0.22; pointer-events: none; }
  .letter > :global(* + *) { margin-top: var(--flow); }
  .letter h2 { text-align: center; }
  .dropcap::first-letter { font-family: var(--font-serif); font-weight: 500; color: var(--color-accent); margin-right: 4px; }
  @supports (initial-letter: 3) or (-webkit-initial-letter: 3) {
    .dropcap::first-letter { -webkit-initial-letter: 3; initial-letter: 3; }
  }
  @supports not ((initial-letter: 3) or (-webkit-initial-letter: 3)) {
    .dropcap::first-letter { float: left; font-size: 4rem; line-height: 0.75; padding-top: 4px; } /* grid-exempt: drop cap optical fit */
  }
  /* First screen: sticky glass nav + hero fill the phone. The hero is one container (three chunks:
     "the wedding of" / names / date + venue), centered, 88px apart. Style follows a letterpress
     invitation: tracked caps serif, with script only for the (huge, overlapping) ampersand and the venue. */
  .hero {
    position: relative; display: flex; flex-direction: column; justify-content: center; align-items: center; gap: 88px;
    overflow-x: clip;                          /* the huge ampersand must not cause sideways scroll */
    min-height: calc(100vh - var(--nav-h));
    min-height: calc(100svh - var(--nav-h));
  }
  .hero > :not(.art) { position: relative; z-index: 1; }
  /* The art runs from the top of the page (behind the glass nav) to the bottom of the first screen,
     fading gradually (over most of its height) into the page background. */
  .art { position: absolute; left: 0; right: 0; top: calc(-1 * var(--nav-h)); bottom: 0; width: 100%; height: calc(100% + var(--nav-h)); object-fit: cover; object-position: center bottom; z-index: 0;
    opacity: 0.6;
    -webkit-mask-image: linear-gradient(to bottom, #000 20%, transparent 100%); mask-image: linear-gradient(to bottom, #000 20%, transparent 100%); }

  .hero p { margin: 0; }
  .script-sm { font-family: var(--font-script); font-size: var(--text-script-sm); line-height: 1; color: var(--color-accent); }
  /* Names stacked tightly; the ampersand is centered over the gap and sits in front of both. */
  .names { position: relative; display: flex; flex-direction: column; align-items: center; gap: 40px; font-size: 0; line-height: 0; }
  .nm {
    font-family: var(--font-serif); font-weight: 400; font-size: calc(var(--text-caps-name) * var(--name-scale)); line-height: 1.1;
    letter-spacing: var(--tracking-name); margin-right: calc(-1 * var(--tracking-name)); text-transform: uppercase; color: var(--color-text);
  }
  .amp {
    position: absolute; left: 50%; top: 50%; z-index: 2; pointer-events: none;
    transform: translate(-51.3%, -47.5%);     /* optically centered (Ruthie's ink is nearly centered in its box) */
    mix-blend-mode: multiply;                 /* on top of the names, but they still read through it */
    font-family: var(--font-amp); font-size: calc(var(--text-script-amp) * var(--amp-scale)); line-height: 1; color: var(--color-amp);
  }
  .when { display: flex; flex-direction: column; align-items: center; gap: 8px; }
  .caps-lg, .caps {
    font-family: var(--font-serif); text-transform: uppercase; letter-spacing: var(--tracking-caps-wide);
    margin-right: calc(-1 * var(--tracking-caps-wide)); line-height: 1.4;
  }
  .caps-lg { font-size: var(--text-caps-lg); color: var(--color-text); }
  .caps { font-size: var(--text-caps); color: var(--color-body); }

  /* Shorter screens: tighten spacing and step the names down so the hero still fits */
  @media (max-height: 720px) {
    .hero { gap: 48px; }
    .nm { font-size: calc(min(var(--text-caps-name), 2.5rem) * var(--name-scale)); }
    .amp { font-size: calc(10rem * var(--amp-scale)); }
    .names { gap: 32px; }
  }
  /* Narrow phones: keep the date on one line */
  @media (max-width: 359px) { .caps-lg { font-size: 0.875rem; letter-spacing: 0.16em; margin-right: -0.16em; } }  /* grid-exempt: type size */

  @media (max-height: 600px) {
    .hero { gap: 24px; }
    .nm { font-size: calc(min(var(--text-caps-name), 2rem) * var(--name-scale)); }
    .amp { font-size: calc(7.78rem * var(--amp-scale)); }   /* grid-exempt: type size */
    .names { gap: 24px; }
    .script-sm { font-size: 2rem; }
  }

  /* Sign-off: ink script, slightly transparent so it sits softer on the paper */
  .sig { opacity: var(--signature-opacity); }

  /* Decorative sprigs (placeholders) */
  .sprig { position: absolute; width: 96px; height: auto; pointer-events: none; }
  .tr { right: 0; top: -48px; }
  .br { right: 0; bottom: -72px; }
</style>
