---
import Base from '../layouts/Base.astro';
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
---
<Base title="Breanna & Eric" fullScreen>
  <!-- Watercolor sits behind the date + location. Placeholder slice of the Canva hero (CONTENT-TODO §3). -->
  <img class="art" src={`${base}images/placeholders/art-hero.jpg`} alt="" data-temp />
  <section class="page hero" data-align="center">
    <p class="eyebrow">The wedding of</p>
    <h1>Breanna<br />&amp; Eric</h1>
    <div class="when">
      <p class="date">September 16<sup>th</sup> to 19<sup>th</sup> 2027</p>
      <p class="loc"><em>Borgo Laticastelli, Tuscany, Italy</em></p>
    </div>
    <!-- TODO: hero watercolor background (CONTENT-TODO §3) -->
  </section>
</Base>

<style>
  /* Home never scrolls: nav pinned top, footer pinned bottom. The hero is one container
     (eyebrow / names / date+location, 88px apart) centered in the space between them.
     Date+location is its own container with a 4px gap. */
  .art { position: absolute; left: 0; right: 0; bottom: 0; width: 100%; height: 224px; object-fit: cover; object-position: center bottom; z-index: 0; opacity: 0.7;
    -webkit-mask-image: linear-gradient(to bottom, transparent, #000 45%); mask-image: linear-gradient(to bottom, transparent, #000 45%); }
  .hero { position: relative; z-index: 1; flex: 1; min-height: 0; display: flex; flex-direction: column; justify-content: center; gap: 88px; }
  /* Container 3: hugs its two children (date, location); the 4px gap is the only space between them.
     Zero the global `p + p` margin, which would otherwise stack on top of the gap. */
  .when { display: flex; flex-direction: column; gap: 4px; height: fit-content; }
  .when > p { margin: 0; }
  /* Hero names: size is the smaller of a width limit (so "Breanna" never overflows) and a
     height limit (so everything still fits one screen). Sizes/line-heights are paired. */
  .hero { --fs-w: 104px; --lh-w: 88px; --fs-h: 104px; --lh-h: 88px; }
  h1 { font-size: min(var(--fs-w), var(--fs-h)); line-height: min(var(--lh-w), var(--lh-h)); }
  .date { font-size: var(--text-subhead); line-height: var(--leading-subhead); }
  sup { font-size: 0.5em; line-height: 0; vertical-align: baseline; position: relative; top: -0.6em; }

  /* Narrower phones */
  @media (max-width: 383px) { .hero { --fs-w: 96px; --lh-w: 80px; } }
  @media (max-width: 359px) { .hero { --fs-w: 80px; --lh-w: 64px; } }

  /* Shorter screens */
  @media (max-height: 720px) {
    .hero { gap: 40px; --fs-h: 96px; --lh-h: 80px; }
    .date { font-size: 1.5rem; line-height: 32px; }
  }
  @media (max-height: 600px) {
    .hero { gap: 24px; --fs-h: 80px; --lh-h: 64px; }
  }
</style>
